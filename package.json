{
  "name": "citation-ci",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Catch broken doc links, redirects, and missing anchors on preview deployments before merging.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "node src/cli.ts",
    "test": "node --test test/*.test.mjs",
    "demo": "node examples/demo.mjs",
    "typecheck": "tsc",
    "build": "esbuild src/cli.ts --bundle --minify --platform=node --target=node24 --format=esm --outfile=dist/cli.mjs"
  },
  "dependencies": {
    "csv-parse": "7.0.3",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm-autolink-literal": "2.1.2",
    "micromark-extension-gfm-autolink-literal": "2.1.0",
    "parse5": "7.3.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
